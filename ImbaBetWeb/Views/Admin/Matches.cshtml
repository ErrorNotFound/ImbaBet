@model ImbaBetWeb.Model.Matchplan

@{
    ViewData["Title"] = "Matches - Administration";
}
<h1>@ViewData["Title"]</h1>
<br />

<form method="post" asp-action="Matches">
    @for (int i = 0; i < Model.MatchGroups.Count(); i++)
    {
        <table class="table table-hover">
            <thead>
                <tr class="table-success">
                    <th>
                        @Html.DisplayFor(modelItem => Model.MatchGroups.ElementAt(i).Name)
                        @Html.HiddenFor(modelItem => Model.MatchGroups.ElementAt(i).Name)
                        @Html.HiddenFor(modelItem => Model.MatchGroups.ElementAt(i).Id)
                    </th>
                </tr>
                <tr class="table-secondary">
                    <th>
                        Alternative Team A
                    </th>
                    <th>
                        Team A
                    </th>
                    <th>
                    
                    </th>
                    <th>
                        Team B
                    </th>
                    <th>
                        Alternative Team B
                    </th>
                    <th style="text-align: center;">
                        IsOver
                    </th>
                    <th>
                        Date
                    </th>
                </tr>
            </thead>

            <tbody>
                @for (int j = 0; j < Model.Matches.Count(); j++)
                {
                    if (Model.MatchGroups.ElementAt(i).Id != Model.Matches.ElementAt(j).MatchGroupId)
                    {
                        continue;
                    }

                    @Html.HiddenFor(modelItem => Model.Matches.ElementAt(j).Id)
                    @Html.HiddenFor(modelItem => Model.Matches.ElementAt(j).MatchGroupId)
                    <tr>
                        <td>
                            @Html.TextBoxFor(model => Model.Matches.ElementAt(j).AlternativeTeamAText)
                        </td>
                        <td>
                            @Html.DropDownListFor(model => Model.Matches.ElementAt(j).TeamATeamId, new SelectList(Model.Teams, "Id", "Name"), "", Model.Matches.ElementAt(j).TeamATeamId)
                        </td>
                        <td>
                            @Html.TextBoxFor(model => Model.Matches.ElementAt(j).GoalsA, new { style = "width:40px;text-align:center;", type = "number" }) : @Html.TextBoxFor(model => Model.Matches.ElementAt(j).GoalsB, new { style = "width:40px;text-align:center;", type = "number" })
                        </td>
                        <td>
                            @Html.DropDownListFor(model => Model.Matches.ElementAt(j).TeamBTeamId, new SelectList(Model.Teams, "Id", "Name"), "", Model.Matches.ElementAt(j).TeamBTeamId)
                        </td>
                        <td>
                            @Html.TextBoxFor(model => Model.Matches.ElementAt(j).AlternativeTeamBText)
                        </td>
                        <td style="text-align: center;">
                            @Html.CheckBoxFor(model => Model.Matches.ElementAt(j).IsOver)
                        </td>
                        <td>
                            @Html.TextBoxFor(model => Model.Matches.ElementAt(j).DateTime)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</form>

